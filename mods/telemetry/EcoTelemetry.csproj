<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EcoTelemetry</RootNamespace>
    <AssemblyName>EcoTelemetry</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>0.1.0</Version>
    <Authors>coilysiren</Authors>
    <Description>OpenTelemetry-backed observability mod for Eco game servers. Exports exceptions, runtime metrics, simulation perf, and traces via OTLP.</Description>
    <PackageProjectUrl>https://github.com/coilyco-flight-deck/eco-telemetry</PackageProjectUrl>
    <RepositoryUrl>https://github.com/coilyco-flight-deck/eco-telemetry</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <NoWarn>NETSDK1138;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Eco.ReferenceAssemblies" Version="0.14.2-beta-release-1099">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!-- Eco serializes web responses with Newtonsoft.Json, so ClimateSettingsDto
         carries Newtonsoft attributes. Compile-time only; the runtime copy comes
         from Eco's own bundled Newtonsoft.Json. Same pattern as mods/stores. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- The climate-settings [ApiController] needs the ASP.NET Core types. The
       Eco server hosts ASP.NET Core, so the shared framework is provided at
       runtime - this reference is compile-time only (nothing is copied). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Api" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
  </ItemGroup>

</Project>
