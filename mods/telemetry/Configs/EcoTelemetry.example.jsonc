{
  "ServiceName": "eco-server",
  "ResourceAttributes": {
    "deployment.environment": "production",
    "service.namespace": "games"
  },

  // Default OTLP target. Used as a fallback when a per-signal endpoint is empty.
  // For a single-backend setup, fill this in and leave the per-signal overrides blank.
  "OtlpEndpoint": "",
  "OtlpProtocol": "HttpProtobuf",
  "OtlpHeaders": "",

  // Per-signal endpoints. Use these when logs and metrics route to different backends.
  // Give the full URL with its path: the plugin sets the endpoint in code, and the OTLP
  // exporter then posts to it as-is, without appending /v1/logs, /v1/metrics or /v1/traces.
  // (e.g. logs to SigNoz, metrics to VictoriaMetrics). Empty means "fall back to OtlpEndpoint above".
  //
  // SigNoz logs example:
  //   "OtlpLogsEndpoint": "http://signoz-otel-collector.observability.svc:4318/v1/logs",
  //   "OtlpLogsProtocol": "HttpProtobuf",
  //   "OtlpLogsHeaders": "",
  //
  // VictoriaMetrics example (no auth, native OTLP ingest):
  //   "OtlpMetricsEndpoint": "http://<vmsingle-host>:8428/opentelemetry/api/v1/push",
  //   "OtlpMetricsProtocol": "HttpProtobuf",
  //   "OtlpMetricsHeaders": "",
  //
  // Traces example (OTLP-native span backend, e.g. Grafana Tempo / Jaeger collector):
  //   "OtlpTracesEndpoint": "http://<tempo-host>:4318/v1/traces",
  //   "OtlpTracesProtocol": "HttpProtobuf",
  //   "OtlpTracesHeaders": "",
  "OtlpLogsEndpoint": "",
  "OtlpLogsProtocol": "",
  "OtlpLogsHeaders": "",
  "OtlpMetricsEndpoint": "",
  "OtlpMetricsProtocol": "",
  "OtlpMetricsHeaders": "",
  "OtlpTracesEndpoint": "",
  "OtlpTracesProtocol": "",
  "OtlpTracesHeaders": "",

  "EnableLogs": true,
  "EnableMetrics": false,
  "EnableTraces": false,

  "MetricsIntervalSeconds": 15,

  // Handlers slower than this (ms) get a trace span; faster ones are skipped.
  "SlowHandlerThresholdMs": 100,

  "FirstChanceExceptionsEnabled": false,
  "InterceptLogWriter": true
}
