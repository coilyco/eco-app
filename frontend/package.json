{
  "name": "eco-app-frontend",
  "description": "React SPA for eco-app.coilysiren.me, served by the fused eco-app service",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "vite",
    "og": "node scripts/og-cards.mjs",
    "build": "node scripts/og-cards.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "kit-check": "node scripts/kit-check.mjs"
  },
  "dependencies": {
    "@sentry/react": "10.75.3",
    "playcanvas": "2.22.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@fontsource/chakra-petch": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "4.10.2",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "playwright-core": "1.55.0",
    "satori": "0.33.5",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.61.0",
    "upng-js": "^2.1.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.8"
  }
}
