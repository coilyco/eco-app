{
  "_comment": "The SPA route table and its crawl policy, owned here and read by both consumers: frontend/src/routes.tsx builds the react-router table from it, and src/eco_mcp_app/seo.py builds robots.txt, sitemap.xml, the 404 rule for unknown paths, and the per-response X-Robots-Tag. Two hand-maintained lists is how the crawl policy drifts back out of sync with the router, so there is one.",
  "site": "https://eco-app.coilysiren.me",
  "routes": [
    { "path": "/", "component": "Home", "crawl": "index" },
    { "path": "/mods", "component": "Mods", "crawl": "index" },
    { "path": "/wiki", "component": "Wiki", "crawl": "index" },
    {
      "path": "/jobs/*",
      "component": "Jobs",
      "crawl": "index",
      "deepCrawl": "noindex",
      "note": "The wildcard swallows the retired server-rendered sub-paths (/jobs/professions). Only /jobs itself is canonical, so anything deeper renders but stays out of the index."
    },
    { "path": "/trade", "component": "Trade", "crawl": "index" },
    { "path": "/crafting", "component": "Crafting", "crawl": "index" },
    { "path": "/items", "component": "Items", "crawl": "index" },
    {
      "path": "/item",
      "component": "Item",
      "crawl": "noindex",
      "note": "One page per item keyed by ?id= (the item id minus Item), holding market, recipes, and uses. The retired ?item= form redirects in the client. Thousands of URLs over one shell."
    },
    { "path": "/recipes", "component": "Recipes", "crawl": "index" },
    {
      "path": "/recipe",
      "component": "Recipe",
      "crawl": "noindex",
      "note": "Kept so old links never 404: the page redirects ?id=<recipe> to its card on the product's item page (eco-app#8383)."
    },
    { "path": "/civics", "component": "Civics", "crawl": "index" },
    { "path": "/uses", "component": "Uses", "crawl": "index" },
    { "path": "/uses/demand", "component": "UsesDemand", "crawl": "index" },
    { "path": "/uses/food", "component": "UsesFood", "crawl": "index" },
    { "path": "/uses/buy-sell", "component": "UsesBuySell", "crawl": "index" },
    { "path": "/uses/arbitrage", "component": "UsesArbitrage", "crawl": "index" },
    { "path": "/uses/price", "component": "UsesPrice", "crawl": "index" },
    { "path": "/uses/resolve", "component": "UsesResolve", "crawl": "index" },
    { "path": "/uses/shop-check", "component": "UsesShopCheck", "crawl": "index" },
    { "path": "/map", "component": "Map", "crawl": "index" },
    { "path": "/species", "component": "Species", "crawl": "index" },
    {
      "path": "/replay",
      "component": "Replay",
      "crawl": "noindex",
      "gate": "password",
      "note": "URL-only and behind the soft password gate (eco-app#73)."
    }
  ],
  "redirects": [
    { "from": "/server", "to": "/" },
    { "from": "/info", "to": "/" },
    { "from": "/social", "to": "/" },
    { "from": "/progression", "to": "/jobs" },
    { "from": "/economy", "to": "/" },
    { "from": "/calculator", "to": "/" },
    { "from": "/trades", "to": "/trade" },
    { "from": "/world", "to": "/map" },
    { "from": "/ecoregion", "to": "/map" },
    { "from": "/climate", "to": "/map" },
    { "from": "/users", "to": "/" }
  ],
  "disallow": [
    "/api/",
    "/mcp/",
    "/admin",
    "/preview/",
    "/preview.json",
    "/preview-map.json",
    "/jobs/api/",
    "/replay/api/",
    "/page-auth",
    "/healthz"
  ]
}
